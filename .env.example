# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# Only public keys go here. NEVER add the service role / secret key to a
# NEXT_PUBLIC_* variable.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Legacy alternative if your project still uses the anon JWT key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Local AI (optional). Only free-form messages use it; short formats like
# "Uber 1200 Kasun" are parsed without AI. Defaults shown.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:4b
